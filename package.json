{
  "name": "cmux-claude-code",
  "version": "0.1.0",
  "description": "Desktop cmux integration for Claude Code — run multiple Claude Code sessions in tabs.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --platform=browser --target=chrome120 --outfile=dist/renderer/renderer.js --sourcemap",
    "copy:assets": "node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --enable-logging",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "package": "npm run build && electron-builder",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist release"
  },
  "keywords": [
    "claude-code",
    "cmux",
    "electron",
    "terminal",
    "multiplexer",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^20.11.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.cmux.claude-code",
    "productName": "cmux for Claude Code",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}
